pipeline {
    agent any

    tools {
        nodejs "NodeJS_22"
    }

    environment {
        AWS_REGION = "ap-south-1"
        S3_BUCKET = "mytrade.snsihub.ai"
        CLOUDFRONT_DISTRIBUTION_ID = "E21GX2OMDX42L8"
        // Vite writes to dist/ (not CRA build/)
        BUILD_DIR = "dist"
        VITE_API_BASE = "https://apitrade.snsihub.ai"
    }

    stages {

        stage('Check Node Version') {
            steps {
                sh '''
                    echo "========================================"
                    echo "Node Version:"
                    node -v
                    echo "NPM Version:"
                    npm -v
                    echo "Workspace: $(pwd)"
                    echo "========================================"
                '''
            }
        }

        stage('Clean Workspace') {
            steps {
                dir('frontend') {
                    sh '''
                        echo "Cleaning old build files in frontend/..."
                        rm -rf node_modules
                        rm -rf build
                        rm -rf dist
                        echo "Workspace cleaned."
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    sh '''
                        echo "Installing dependencies from frontend/..."
                        test -f package.json

                        if [ -f package-lock.json ]; then
                          npm ci --legacy-peer-deps || npm install --no-audit --no-fund --legacy-peer-deps
                        else
                          echo "No package-lock.json — using npm install"
                          npm install --no-audit --no-fund --legacy-peer-deps
                        fi

                        echo "Dependencies installed successfully."
                    '''
                }
            }
        }

        stage('Build React App') {
            steps {
                dir('frontend') {
                    sh '''
                        echo "Building Vite application..."
                        echo "VITE_API_BASE=$VITE_API_BASE"
                        export NODE_OPTIONS="--max-old-space-size=4096"
                        export VITE_API_BASE="$VITE_API_BASE"
                        CI=false npm run build
                        echo "Vite build completed."
                    '''
                }
            }
        }

        stage('Verify Build') {
            steps {
                dir('frontend') {
                    sh '''
                        echo "========================================"
                        echo "Verifying build..."
                        echo "========================================"

                        if [ ! -d "$BUILD_DIR" ]; then
                            echo "ERROR: $BUILD_DIR directory was not created."
                            ls -la
                            exit 1
                        fi

                        echo "Build directory ($BUILD_DIR):"
                        ls -lah "$BUILD_DIR"
                        echo "Build verification successful."
                    '''
                }
            }
        }

        stage('Upload to S3') {
            steps {
                dir('frontend') {
                    sh '''
                        echo "========================================"
                        echo "Uploading build to S3..."
                        echo "Bucket: $S3_BUCKET"
                        echo "Region: $AWS_REGION"
                        echo "========================================"

                        aws s3 sync "$BUILD_DIR"/ s3://$S3_BUCKET/ \
                            --delete \
                            --region $AWS_REGION

                        echo "S3 upload completed successfully."
                    '''
                }
            }
        }

        stage('Invalidate CloudFront') {
            steps {
                sh '''
                    echo "========================================"
                    echo "Creating CloudFront invalidation..."
                    echo "Distribution: $CLOUDFRONT_DISTRIBUTION_ID"
                    echo "========================================"

                    aws cloudfront create-invalidation \
                        --distribution-id $CLOUDFRONT_DISTRIBUTION_ID \
                        --paths "/*"

                    echo "CloudFront invalidation created successfully."
                '''
            }
        }
    }

    post {
        success {
            echo "========================================"
            echo "Deployment Successful!"
            echo "========================================"
        }

        failure {
            echo "========================================"
            echo "Deployment Failed!"
            echo "========================================"
        }

        always {
            deleteDir()
        }
    }
}
