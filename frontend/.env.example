# Vite React app — copy to frontend/.env

# --- Use the live API (recommended for your setup) ---
VITE_API_BASE=https://apitrade.snsihub.ai

# --- OR local-only mode ---
# Leave VITE_API_BASE empty so the UI calls /api on the Vite host,
# and Vite proxies those to your local backend:
# VITE_API_BASE=
# VITE_PROXY_TARGET=http://127.0.0.1:8000
#
# VITE_PROXY_TARGET is ignored whenever VITE_API_BASE is set.
