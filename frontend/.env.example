# Vite React app (frontend/src) — copy to frontend/.env
# Used as API origin when UI runs on a different host than the API.

# Local same-origin via Vite proxy (leave empty) OR point at backend:
# VITE_API_BASE=

# Hosted API:
VITE_API_BASE=https://apitrade.snsihub.ai

# Vite proxy target when VITE_API_BASE is empty (dev only)
VITE_PROXY_TARGET=http://127.0.0.1:8000
