# SNS Capital — copy to backend/.env and fill in values
# Never commit backend/.env (gitignored).

# ---------------------------------------------------------------------------
# Server bind (local default = loopback; hosting = 0.0.0.0)
# Cloud platforms often inject PORT — that wins over this file.
# ---------------------------------------------------------------------------
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Comma-separated browser origins allowed for CORS (same-origin SPA needs little).
# Add your public site URL when the UI is on a different host/port.
CORS_ORIGINS=https://apitrade.snsihub.ai,http://apitrade.snsihub.ai,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# ---------------------------------------------------------------------------
# Live market tape
# ---------------------------------------------------------------------------
LIVE_DATA=true
LIVE_POLL_SECONDS=3.0

# ---------------------------------------------------------------------------
# Optional market-data API keys (Yahoo works without these)
# ---------------------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# ---------------------------------------------------------------------------
# Paths (optional overrides)
# ---------------------------------------------------------------------------
# DATA_FILE=data/portfolio.json
# MARKET_TZ=Asia/Kolkata
