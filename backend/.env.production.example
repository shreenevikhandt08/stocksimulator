# SNS Capital — production / VPS / container template
# Copy to backend/.env on the host (or set the same keys in your panel).

APP_ENV=production

# Bind all interfaces so the reverse proxy / container port can reach uvicorn
HOST=0.0.0.0
PORT=8000

# Public API / SPA origin(s). Include https:// and no trailing slash.
CORS_ORIGINS=https://apitrade.snsihub.ai,http://apitrade.snsihub.ai

LIVE_DATA=true
LIVE_POLL_SECONDS=3.0

ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
