# SNS Capital — production / VPS / container template
# Copy to backend/.env on the host (or set the same keys in your panel).

APP_ENV=production

# Bind all interfaces so the reverse proxy / container port can reach uvicorn
HOST=0.0.0.0
PORT=8000

# Replace with your real public URL(s). Include https:// and no trailing slash.
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

LIVE_DATA=true
LIVE_POLL_SECONDS=3.0

ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
