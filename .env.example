# Root pointer for hosting panels that expect a repo-root .env
# Preferred location is still backend/.env (see backend/.env.example).

APP_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=https://apitrade.snsihub.ai,http://apitrade.snsihub.ai,http://127.0.0.1:8000,http://localhost:8000

# Optional keys (also read from backend/.env)
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
LIVE_DATA=true
LIVE_POLL_SECONDS=3.0
